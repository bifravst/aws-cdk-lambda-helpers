{
  "name": "@bifravst/aws-cdk-lambda-helpers",
  "version": "0.0.0-development",
  "description": "Helper functions which simplify working with TypeScript lambdas for AWS CDK.",
  "exports": {
    ".": {
      "import": {
        "types": "./npm/lambda.d.ts",
        "default": "./npm/lambda.js"
      }
    },
    "./layer": {
      "import": {
        "types": "./npm/layer.d.ts",
        "default": "./npm/layer.js"
      }
    },
    "./util": {
      "import": {
        "types": "./npm/util.d.ts",
        "default": "./npm/util.js"
      }
    },
    "./cdk": {
      "import": {
        "types": "./npm/cdk.d.ts",
        "default": "./npm/cdk.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test ./src/*.spec.ts",
    "test:e2e": "node --experimental-strip-types --test e2e.spec.ts",
    "test:e2e:updated": "node --experimental-strip-types --test e2e-updated.spec.ts",
    "prepare": "husky",
    "prepublishOnly": "node --experimental-strip-types .npm/npm-compile.ts && npx tsgo src/*.ts --emitDeclarationOnly --declaration --ignoreConfig --allowImportingTsExtensions --target esnext --module nodenext --moduleResolution nodenext --outDir ./npm && mv npm/src/* npm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/aws-cdk-lambda-helpers.git"
  },
  "bugs": {
    "url": "https://github.com/bifravst/aws-cdk-lambda-helpers/issues"
  },
  "homepage": "https://github.com/bifravst/aws-cdk-lambda-helpers",
  "keywords": [
    "aws",
    "cdk",
    "lambda",
    "typescript"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.980.0",
    "@aws-sdk/client-dynamodb": "3.980.0",
    "@bifravst/cloudformation-helpers": "9.1.1",
    "@bifravst/eslint-config-typescript": "6.4.4",
    "@bifravst/from-env": "3.0.2",
    "@bifravst/prettier-config": "1.1.17",
    "@commitlint/config-conventional": "20.3.1",
    "@swc/cli": "0.7.10",
    "@types/aws-lambda": "8.10.160",
    "@types/node": "25.2.0",
    "@types/unzip-stream": "0.3.4",
    "@types/yazl": "3.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260201.1",
    "cdk": "2.1104.0",
    "commitlint": "20.3.1",
    "husky": "9.1.7",
    "id128": "1.6.6",
    "lint-staged": "16.2.7",
    "unzip-stream": "0.3.4"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm",
    "LICENSE",
    "README.md"
  ],
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@swc/core": "1.15.11",
    "fp-ts": "2.16.11",
    "p-retry": "7.1.1",
    "typescript": "5.9.3",
    "yazl": "3.3.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-lambda": "^3.980.0",
    "@bifravst/aws-ssm-settings-helpers": "^1.2.262",
    "aws-cdk-lib": "^2.236.0",
    "constructs": "^10.4.5"
  }
}
