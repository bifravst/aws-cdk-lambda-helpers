{
  "name": "@bifravst/aws-cdk-lambda-helpers",
  "version": "0.0.0-development",
  "description": "Helper functions which simplify working with TypeScript lambdas for AWS CDK.",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/lambda.d.ts",
        "default": "./dist/src/lambda.js"
      }
    },
    "./layer": {
      "import": {
        "types": "./dist/src/layer.d.ts",
        "default": "./dist/src/layer.js"
      }
    },
    "./util": {
      "import": {
        "types": "./dist/src/util.d.ts",
        "default": "./dist/src/util.js"
      }
    },
    "./cdk": {
      "import": {
        "types": "./dist/src/cdk.d.ts",
        "default": "./dist/src/cdk.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test ./src/*.spec.ts",
    "test:e2e": "node --experimental-strip-types --test e2e.spec.ts",
    "test:e2e:updated": "node --experimental-strip-types --test e2e-updated.spec.ts",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "prepublishOnly": "npx tsc --noEmit false -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/aws-cdk-lambda-helpers.git"
  },
  "bugs": {
    "url": "https://github.com/bifravst/aws-cdk-lambda-helpers/issues"
  },
  "homepage": "https://github.com/bifravst/aws-cdk-lambda-helpers",
  "keywords": [
    "aws",
    "cdk",
    "lambda",
    "typescript"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1119.0",
    "@aws-sdk/client-dynamodb": "3.1119.0",
    "@bifravst/cloudformation-helpers": "10.0.1",
    "@bifravst/eslint-config-typescript": "8.0.2",
    "@bifravst/from-env": "4.0.0",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "26.4.0",
    "@types/unzip-stream": "0.3.4",
    "@types/yazl": "3.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "cdk": "2.1139.0",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.2",
    "husky": "9.1.7",
    "id128": "1.6.6",
    "lint-staged": "17.3.0",
    "unzip-stream": "0.3.4"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@swc/core": "1.16.1",
    "fp-ts": "2.16.11",
    "p-retry": "8.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "yazl": "3.3.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-lambda": "^3.1111.0",
    "@bifravst/aws-ssm-settings-helpers": "2.x",
    "aws-cdk-lib": "^2.265.0",
    "chalk": "6.x",
    "constructs": "^10.8.1"
  }
}
